# Shu faylni ".env" nomi bilan nusxalang va to'ldiring (.env faylni hech kimga yubormang!)

# --- Telegram bot (xohlasangiz solutionX.py ichidagi qiymatlar o'rniga shu yerda bering) ---
# BOT_TOKEN=
# GROUP_ID=
# KANAL_ID=
# ADMIN_IDS=

# --- Gemini: Writing / Speaking AI tekshiruvi ---
# Kalit: https://aistudio.google.com/apikey  (bepul tarifda karta kerak emas)
GEMINI_API_KEY=

# Modellar zanjiri: birinchisida limit tugasa/topilmasa keyingisi sinaladi.
# Hozirgi bepul modellar nomini Google AI Studio'dan tekshirib, kerak bo'lsa yangilang.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.1-flash-lite

# Bitta foydalanuvchiga kuniga nechta AI tekshiruv (adminlar cheksiz)
AI_DAILY_LIMIT=5
# Bir daqiqada Gemini'ga ko'pi bilan nechta so'rov (bepul limitdan oshmaslik uchun) va bir vaqtdagi so'rovlar
AI_RPM=8
AI_CONCURRENCY=3
